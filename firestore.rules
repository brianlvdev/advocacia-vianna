rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function papel() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function logado() { return request.auth != null; }
    function ehAdmin() { return logado() && papel() == 'admin'; }
    function ehEstagiario() { return logado() && papel() == 'estagiario'; }

    match /users/{uid} {
      allow read: if logado() && (request.auth.uid == uid || ehAdmin());
      allow create: if logado()
                    && request.auth.uid == uid
                    && request.resource.data.role == 'cliente';
      allow update: if ehAdmin();
    }

    // Conteúdo público do site (perfil, áreas, estatísticas)
    match /site/{documento} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    match /casos/{casoId} {
      allow create: if logado()
                    && request.resource.data.clienteUid == request.auth.uid
                    && request.resource.data.status == 'novo'
                    && request.resource.data.liberadoParaEstagiario == false;
      allow read: if logado() && (
                    resource.data.clienteUid == request.auth.uid
                    || ehAdmin()
                    || (ehEstagiario() && resource.data.liberadoParaEstagiario == true)
                                      || (ehEstagiario() && resource.data.liberadoParaEstagiario == true
                        && resource.data.estagiarioUid == request.auth.uid));
      allow update: if ehAdmin();
    }
        match /config/{documento} {
      allow read: if logado();
      allow write: if ehAdmin();
    }

    match /ocupados/{slot} {
      allow read: if logado();
      allow create: if logado() && request.resource.data.keys().hasOnly(['inicio']);
      allow update, delete: if ehAdmin();
    }

    match /agendamentos/{id} {
      allow create: if logado()
                    && request.resource.data.clienteUid == request.auth.uid
                    && request.resource.data.status == 'pendente';
      allow read: if logado() && (resource.data.clienteUid == request.auth.uid || ehAdmin());
      allow update, delete: if ehAdmin();
    }
    match /tarefas/{id} {
      allow read: if ehAdmin()
                  || (ehEstagiario() && resource.data.estagiarioUid == request.auth.uid);
      allow create, delete: if ehAdmin();
      allow update: if ehAdmin()
                    || (ehEstagiario()
                        && resource.data.estagiarioUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['concluida']));
    }
  }
}